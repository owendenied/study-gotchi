<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="RetroWindowGrey" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="RetroBorderDark" Color="#2A2A35"/>
    <SolidColorBrush x:Key="RetroHighlight" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RetroShadow" Color="#808080"/>
    <SolidColorBrush x:Key="RetroBackground" Color="#F4F0E6"/>
    <SolidColorBrush x:Key="TitleBarBlue" Color="#6B88B2"/>

    <SolidColorBrush x:Key="BarPink" Color="#E598B8"/>
    <SolidColorBrush x:Key="BarBlue" Color="#84B8D9"/>

    <SolidColorBrush x:Key="TitleBarPurple" Color="#A594C5"/>
    <SolidColorBrush x:Key="TitleBarPink" Color="#E598B8"/>
    <SolidColorBrush x:Key="SelectionTeal" Color="#4EE2EC"/>

    <DropShadowEffect x:Key="DropShadowEffect" Color="#E9CFC9" BlurRadius="24" ShadowDepth="6" Opacity="0.45"/>

    <Style x:Key="RetroProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource RetroBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RetroBorderDark}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}"/>

                        <Rectangle x:Name="PART_Track" Margin="2" />

                        <Grid x:Name="PART_Indicator" HorizontalAlignment="Left" Margin="2">
                            <Rectangle Fill="{TemplateBinding Foreground}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Widget specific brushes -->
    <SolidColorBrush x:Key="WarmCream" Color="#F7EEE8"/>
    <SolidColorBrush x:Key="MintGreen" Color="#B9E9CF"/>
    <SolidColorBrush x:Key="SoftLavender" Color="#EAD9FF"/>

    <!-- Toggle switch style -->
    <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="SwitchBackground" CornerRadius="14" Background="#E9E2DF">
                        <Grid>
                            <Ellipse x:Name="Knob" Width="22" Height="22" Fill="White" Margin="3"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchBackground" Property="Background" Value="#FF7661"/>
                            <Setter TargetName="Knob" Property="Margin" Value="27,3,3,3"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Knob" Property="Width" Value="20"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource RetroBorderDark}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Courier New"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="25" Padding="30,10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- New styles for pet selection screen -->
    <LinearGradientBrush x:Key="MainGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F0DFF6" Offset="0"/>
        <GradientStop Color="#FDE6D0" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="AccentCoral" Color="#FF7661"/>

    <!-- Animations -->
    <Storyboard x:Key="EntranceAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.8"/>
        <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.Y)" From="40" To="0" Duration="0:0:0.8">
            <DoubleAnimation.EasingFunction>
                <PowerEase Power="3" EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <Style x:Key="PetCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#FFFDFB"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Width" Value="220"/>
        <Setter Property="Height" Value="320"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="0"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#F2B7AD" BlurRadius="36" ShadowDepth="8" Opacity="0.45"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.Y)" To="-10" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity" To="0.7" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity" To="0.45" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PetListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter Margin="{TemplateBinding Padding}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentPillButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentCoral}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="28" Padding="24,10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dashboard specific brushes and styles -->
    <SolidColorBrush x:Key="AccentMint" Color="#B9E9CF"/>
    <SolidColorBrush x:Key="AccentPeach" Color="#F7D7CC"/>
    <SolidColorBrush x:Key="AccentLavender" Color="#E9D9FF"/>
    <SolidColorBrush x:Key="HeaderTextColor" Color="#3A1F1A"/>

    <Style x:Key="SidePanelStyle" TargetType="Border">
        <Setter Property="Background" Value="#FFFDFD"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Width" Value="260"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#E9CFC9" BlurRadius="24" ShadowDepth="6" Opacity="0.45"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CenterCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#FFFDFB"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="28"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#F2B7AD" BlurRadius="36" ShadowDepth="8" Opacity="0.35"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TaskPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="#FFFDFB"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Width" Value="300"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#E9CFC9" BlurRadius="24" ShadowDepth="6" Opacity="0.45"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StartSessionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#FF7F66"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="28" Padding="28,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="▶" Margin="0,0,8,0" FontSize="16"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WidgetOpenButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#EAD9FF"/>
        <Setter Property="Foreground" Value="#4E2E9E"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="28" Height="28" Fill="#CFF6E0"/>
                            <TextBlock Text="  Open Widget" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>