<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DropShadowEffect x:Key="DropShadowEffect" Color="#FF85A1" BlurRadius="12" Direction="315" ShadowDepth="3" Opacity="0.2"/>

    <SolidColorBrush x:Key="RetroWindowGrey" Color="#FCE4EC"/>
    <SolidColorBrush x:Key="RetroBorderDark" Color="#8E5D67"/>
    <SolidColorBrush x:Key="RetroHighlight" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RetroShadow" Color="#D1A7B0"/>
    <SolidColorBrush x:Key="RetroBackground" Color="#FFF5F7"/>
    <SolidColorBrush x:Key="TitleBarBlue" Color="#F48FB1"/>
    <SolidColorBrush x:Key="BarPink" Color="#FFB7CE"/>
    <SolidColorBrush x:Key="BarBlue" Color="#B2EBF2"/>
    <SolidColorBrush x:Key="TitleBarPurple" Color="#D1C4E9"/>
    <SolidColorBrush x:Key="TitleBarPink" Color="#FFB7CE"/>
    <SolidColorBrush x:Key="SelectionTeal" Color="#A7FFEB"/>
    <SolidColorBrush x:Key="AccentCoral" Color="#FF8A80"/>

    <LinearGradientBrush x:Key="MainGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FCE4EC" Offset="0"/>
        <GradientStop Color="#FFF3E0" Offset="1"/>
    </LinearGradientBrush>

    <!-- The "Cute" Color Palette -->
    <SolidColorBrush x:Key="GotchiButtonBlue" Color="#FFC1D6"/>
    <SolidColorBrush x:Key="GotchiBorderYellow" Color="#FF85A1"/>
    <SolidColorBrush x:Key="GotchiTextDark" Color="#8E5D67"/>
    <SolidColorBrush x:Key="HeaderTextColor" Color="#3A1F1A"/>
    <FontFamily x:Key="PixelifyFont">pack://application:,,,/Assets/Fonts/#Pixelify Sans</FontFamily>
    
    <!-- Adding a style without an x:Key makes it apply to ALL TextBlocks automatically -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PixelifyFont}"/>
    </Style>

    <Style TargetType="Image">
        <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor"/>
    </Style>

    <!-- Main Big Pixel Buttons (Hatching/Menu) -->
    <Style x:Key="StudyGotchiButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GotchiButtonBlue}"/>
        <Setter Property="Foreground" Value="{StaticResource GotchiTextDark}"/>
        <Setter Property="FontFamily" Value="{StaticResource PixelifyFont}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{StaticResource GotchiBorderYellow}" 
                            BorderThickness="4" 
                            CornerRadius="20" 
                            Padding="30,5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFD1E1"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#FF4F79"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="2"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Egg selection ListBoxItem style -->
    <Style x:Key="EggItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <!-- Use a Grid to stack the arrow and the egg vertically -->
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Row for the Arrow -->
                            <RowDefinition Height="*"/>
                            <!-- Row for the Egg -->
                        </Grid.RowDefinitions>

                        <!-- The Selection Arrow (Hidden by default) -->
                        <Path x:Name="SelectionArrow"
                          Data="M 0,0 L 10,0 L 5,8 Z" 
                          Fill="{StaticResource GotchiBorderYellow}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Bottom"
                          Height="12" Width="15"
                          Stretch="Fill"
                          Margin="0,0,0,5"
                          Visibility="Collapsed"/>

                        <!-- The Egg Container -->
                        <Border x:Name="SelectionBorder" 
                            Grid.Row="1"
                            BorderThickness="4" 
                            BorderBrush="Transparent" 
                            CornerRadius="25" 
                            Padding="8"
                            Background="Transparent">
                            <ContentPresenter x:Name="EggContent" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <!-- Show the arrow -->
                            <Setter TargetName="SelectionArrow" Property="Visibility" Value="Visible"/>

                            <!-- Update the border and background -->
                            <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{StaticResource GotchiBorderYellow}"/>
                            <Setter TargetName="SelectionBorder" Property="Background" Value="#44FFB7CE"/>

                            <!-- Subtle "Pop" effect: moves the egg slightly down when selected -->
                            <Setter TargetName="EggContent" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="2"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle switch (e.g. Settings page) -->
    <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="border" Width="44" Height="24" CornerRadius="12" Background="#F8BBD0" BorderThickness="2" BorderBrush="#F48FB1">
                        <Ellipse x:Name="thumb" Width="16" Height="16" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="2,2,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FF85A1"/>
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="thumb" Property="Margin" Value="0,2,2,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    


    <!-- Standard Pill Button (Dashboard Controls) -->
    <Style x:Key="PillButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#F8BBD0"/>
        <Setter Property="Foreground" Value="#8E5D67"/>
        <Setter Property="FontFamily" Value="{StaticResource PixelifyFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="20,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="#F48FB1" BorderThickness="2"
                            CornerRadius="20" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FCE4EC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent Pill Button (Primary Actions) -->
    <Style x:Key="AccentPillButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#FF85A1"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource PixelifyFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="#D81B60" BorderThickness="2"
                            CornerRadius="20" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FF4F79"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Start Session Big Button -->
    <Style x:Key="StartSessionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentPillButtonStyle}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Widget Open Button (Subtle Text) -->
    <Style x:Key="WidgetOpenButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#FF85A1"/>
        <Setter Property="FontFamily" Value="{StaticResource PixelifyFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Dashboard Panel Labels -->
    <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PixelifyFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#8E5D67"/>
        <Setter Property="FontSize" Value="18"/>
    </Style>

    <!-- Existing Layout Styles Kept for Stability -->
    <Style x:Key="SidePanelStyle" TargetType="Border">
        <Setter Property="Background" Value="#FFF9FB"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Effect" Value="{StaticResource DropShadowEffect}"/>
        <Setter Property="BorderBrush" Value="#FCE4EC"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style x:Key="CenterCardStyle" TargetType="Border" BasedOn="{StaticResource SidePanelStyle}"/>
    <Style x:Key="TaskPanelStyle" TargetType="Border" BasedOn="{StaticResource SidePanelStyle}"/>

</ResourceDictionary>
