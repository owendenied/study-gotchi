<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PrimaryPink" Color="#FFB7C5"/>
    <SolidColorBrush x:Key="SoftLavender" Color="#D4BBFF"/>
    <SolidColorBrush x:Key="MintGreen" Color="#B5EAD7"/>
    <SolidColorBrush x:Key="WarmCream" Color="#FFF5E4"/>
    <SolidColorBrush x:Key="SoftYellow" Color="#FFEAA7"/>
    <SolidColorBrush x:Key="DangerRed" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="DarkText" Color="#3D3D3D"/>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource WarmCream}"/>
    </Style>

    <Style TargetType="UserControl">
        <Setter Property="Background" Value="{StaticResource WarmCream}"/>
    </Style>

</ResourceDictionary>