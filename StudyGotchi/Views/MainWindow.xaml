<Window x:Class="StudyGotchi.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StudyGotchi.ViewModels"
        xmlns:uc="clr-namespace:StudyGotchi.Views.UserControls"
        mc:Ignorable="d"
        Title="Study-Gotchi"
        Height="600" Width="900"
        MinWidth="900" MinHeight="600"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        Icon="/Assets/Background/golden_egg.png">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:PetSelectionViewModel}">
            <uc:PetSelectionView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <uc:DashboardView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <ContentControl Content="{Binding CurrentViewModel}" />

        <!-- Toast Notification Overlay -->
        <Border x:Name="ToastBorder"
                Background="#EEFFFFFF"
                BorderBrush="#FF7F66"
                BorderThickness="2"
                CornerRadius="14"
                Padding="18,12"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,40,0,0"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                MinWidth="280"
                MaxWidth="420">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.2" ShadowDepth="3"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtToastIcon"
                           Grid.Column="0"
                           Text="!"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#FF7F66"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock x:Name="TxtToastTitle"
                               Text="NOTICE"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#FF7F66"/>
                    <TextBlock x:Name="TxtToastMessage"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#3A1F1A"
                               MaxWidth="340"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
