<Window x:Class="StudyGotchi.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StudyGotchi.ViewModels"
        xmlns:views="clr-namespace:StudyGotchi.Views.UserControls"
        Title="Study-Gotchi" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:PetSelectionViewModel}">
            <views:PetSelectionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <!-- Add other mappings as they are converted -->
    </Window.Resources>
    <Grid>
        <ContentControl Content="{Binding CurrentViewModel}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Grid>
</Window>