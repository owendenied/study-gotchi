<Window x:Class="StudyGotchi.Views.MainSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Study-Gotchi 🐣"
        Height="600" Width="900"
        MinHeight="560" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WarmCreamBrush}"
        FontFamily="Nunito, Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Study-Gotchi 🌸" Style="{StaticResource HeadingText}"/>

            <Button Grid.Column="1" x:Name="SettingsButton" Content="⚙ Settings"
                    Style="{StaticResource SecondaryButton}" Click="SettingsButton_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CuteCard}">
                <StackPanel>
                    <TextBlock Text="Choose Your Pet 🐾" Style="{StaticResource BodyText}"
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                    <StackPanel x:Name="PetSelectionPanel" Orientation="Horizontal" HorizontalAlignment="Center">

                        <Border x:Name="PetACard" Width="100" Height="120" CornerRadius="12"
                                Background="{StaticResource MintGreenBrush}" Margin="8"
                                Cursor="Hand" MouseLeftButtonUp="PetACard_Click">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image x:Name="PetAImage" Width="64" Height="64" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock Text="Pet A" Style="{StaticResource SmallText}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="PetBCard" Width="100" Height="120" CornerRadius="12"
                                Background="{StaticResource SoftLavenderBrush}" Margin="8"
                                Cursor="Hand" MouseLeftButtonUp="PetBCard_Click">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image x:Name="PetBImage" Width="64" Height="64" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock Text="Pet B" Style="{StaticResource SmallText}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="PetCCard" Width="100" Height="120" CornerRadius="12"
                                Background="{StaticResource SoftYellowBrush}" Margin="8"
                                Cursor="Hand" MouseLeftButtonUp="PetCCard_Click">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image x:Name="PetCImage" Width="64" Height="64" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock Text="Pet C" Style="{StaticResource SmallText}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="SelectedPetLabel" Text="No pet selected"
                               Style="{StaticResource SmallText}" HorizontalAlignment="Center"
                               Margin="0,12,0,0" Foreground="{StaticResource SubtleGrayBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CuteCard}">
                <StackPanel>
                    <TextBlock Text="Add Your Tasks 📝" Style="{StaticResource BodyText}"
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                    <TextBlock Text="Task Name" Style="{StaticResource SmallText}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TaskNameInput" Style="{StaticResource CuteTextBox}"
                             PlaceholderText="e.g. Finish Chapter 3 notes" Margin="0,0,0,12"/>

                    <TextBlock Text="Deadline" Style="{StaticResource SmallText}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DeadlinePicker" Margin="0,0,0,12" FontFamily="Nunito, Segoe UI"/>

                    <Button Content="+ Add Task" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Click="AddTaskButton_Click" Margin="0,0,0,16"/>

                    <TextBlock Text="Your Tasks:" Style="{StaticResource SmallText}" Margin="0,0,0,8"/>
                    <ListBox x:Name="TaskListBox" Height="180" BorderThickness="0"
                             Background="Transparent" FontFamily="Nunito, Segoe UI" FontSize="13"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ValidationMessage" Grid.Column="0" Style="{StaticResource SmallText}"
                       Foreground="{StaticResource DangerRedBrush}" VerticalAlignment="Center"/>

            <Button Grid.Column="1" Content="Start Study Session 🚀" Style="{StaticResource PrimaryButton}"
                    FontSize="16" Click="StartSessionButton_Click"/>
        </Grid>
    </Grid>
</Window>