<Window x:Class="StudyGotchi.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings ⚙"
        Height="320" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WarmCreamBrush}"
        FontFamily="Nunito, Segoe UI">

    <StackPanel Margin="24">
        <TextBlock Text="Settings 🎀"
                   Style="{StaticResource HeadingText}"
                   FontSize="22"
                   Margin="0,0,0,20"/>

        <TextBlock Text="Pet Name" Style="{StaticResource SmallText}" Margin="0,0,0,4"/>
        <TextBox x:Name="PetNameInput"
                 Style="{StaticResource CuteTextBox}"
                 Margin="0,0,0,16"/>

        <TextBlock Text="Hunger Decay Speed"
                   Style="{StaticResource SmallText}"
                   Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,4">
            <TextBlock Text="Slow" Style="{StaticResource SmallText}"/>
            <TextBlock Text="Fast" Style="{StaticResource SmallText}"
                       HorizontalAlignment="Right"/>
        </Grid>
        <Slider x:Name="DecaySpeedSlider"
                Minimum="1" Maximum="5" Value="2"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                Margin="0,0,0,24"/>

        <Button Content="Save Settings ✓"
                Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right"
                Click="SaveButton_Click"/>
    </StackPanel>
</Window>