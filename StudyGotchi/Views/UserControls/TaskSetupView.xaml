<UserControl x:Class="StudyGotchi.Views.UserControls.TaskSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Apply the pixel art background here -->
    <UserControl.Background>
        <ImageBrush ImageSource="pack://application:,,,/Assets/Background/pixel_bg.png" 
                    Stretch="UniformToFill" 
                    RenderOptions.BitmapScalingMode="NearestNeighbor"/>
    </UserControl.Background>

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="560" Padding="32" Background="#FFFDFB" CornerRadius="18" Effect="{StaticResource DropShadowEffect}">
            <StackPanel>
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,18">
                    <TextBlock Text="Add a Task" FontSize="26" FontWeight="Bold" Foreground="#3A1F1A" HorizontalAlignment="Center"/>
                    <TextBlock Text="What do you need to tackle?" FontSize="12" Foreground="#8A6F6B" HorizontalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="What do I need to do?" FontWeight="SemiBold" Margin="0,4"/>
                <Border Background="#FFF6F4" CornerRadius="10" Padding="12" Margin="0,6,0,14">
                    <TextBox x:Name="TxtTaskName" Text="" Background="Transparent" BorderThickness="0" AcceptsReturn="True" Height="120" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="Deadline" FontWeight="SemiBold" Margin="0,6"/>
                <Border Background="#FFF6F4" CornerRadius="10" Padding="8" Margin="0,6,0,12">
                    <DatePicker x:Name="DpDeadline" Background="Transparent" BorderThickness="0"/>
                </Border>

                <Button x:Name="BtnAddTask" Content="Add Task ✓" Click="BtnAddTask_Click" Style="{StaticResource AccentPillButtonStyle}" HorizontalAlignment="Center" Padding="40,12" Margin="0,8"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnBack" Content="← Back" Grid.Column="0" Click="BtnBack_Click" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#FF7F66"/>
                    <Button x:Name="BtnNext" Content="Next →" Grid.Column="1" Click="BtnNext_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#FF7F66"/>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>