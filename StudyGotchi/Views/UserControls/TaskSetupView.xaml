<UserControl x:Class="StudyGotchi.Views.UserControls.TaskSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource MainGradientBrush}">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="560" Padding="32" Background="#FFFDFB" CornerRadius="18" Effect="{StaticResource DropShadowEffect}">
            <StackPanel>
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,18">
                    <TextBlock Text="Add a Task" FontSize="26" FontWeight="Bold" Foreground="#3A1F1A" HorizontalAlignment="Center"/>
                    <TextBlock Text="What do you need to tackle?" FontSize="12" Foreground="#8A6F6B" HorizontalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="What do I need to do?" FontWeight="SemiBold" Margin="0,4"/>
                <Border Background="#FFF6F4" CornerRadius="10" Padding="12" Margin="0,6,0,14">
                    <TextBox x:Name="TxtTaskName" Text="" Background="Transparent" BorderThickness="0" AcceptsReturn="True" Height="120" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="Due time" FontWeight="SemiBold" Margin="0,6"/>
                <Border Background="#FFF6F4" CornerRadius="10" Padding="10,8" Margin="0,6,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Hour picker -->
                        <ComboBox x:Name="CmbHour" Width="64" Margin="0,0,4,0" SelectedIndex="23">
                            <ComboBoxItem Content="00"/><ComboBoxItem Content="01"/><ComboBoxItem Content="02"/>
                            <ComboBoxItem Content="03"/><ComboBoxItem Content="04"/><ComboBoxItem Content="05"/>
                            <ComboBoxItem Content="06"/><ComboBoxItem Content="07"/><ComboBoxItem Content="08"/>
                            <ComboBoxItem Content="09"/><ComboBoxItem Content="10"/><ComboBoxItem Content="11"/>
                            <ComboBoxItem Content="12"/><ComboBoxItem Content="13"/><ComboBoxItem Content="14"/>
                            <ComboBoxItem Content="15"/><ComboBoxItem Content="16"/><ComboBoxItem Content="17"/>
                            <ComboBoxItem Content="18"/><ComboBoxItem Content="19"/><ComboBoxItem Content="20"/>
                            <ComboBoxItem Content="21"/><ComboBoxItem Content="22"/><ComboBoxItem Content="23"/>
                        </ComboBox>
                        <TextBlock Text=":" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,4,0"/>
                        <!-- Minute picker -->
                        <ComboBox x:Name="CmbMinute" Width="64" Margin="0,0,16,0" SelectedIndex="0">
                            <ComboBoxItem Content="00"/><ComboBoxItem Content="05"/><ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="15"/><ComboBoxItem Content="20"/><ComboBoxItem Content="25"/>
                            <ComboBoxItem Content="30"/><ComboBoxItem Content="35"/><ComboBoxItem Content="40"/>
                            <ComboBoxItem Content="45"/><ComboBoxItem Content="50"/><ComboBoxItem Content="55"/>
                        </ComboBox>
                        <!-- Tomorrow toggle -->
                        <CheckBox x:Name="ChkTomorrow" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Tomorrow" VerticalAlignment="Center" Foreground="#6E4E4A" FontSize="13"/>
                    </StackPanel>
                </Border>
                <!-- Preview label -->
                <TextBlock x:Name="TxtDeadlinePreview" FontSize="11" Foreground="#9A8A86" Margin="0,0,0,12"/>

                <Button x:Name="BtnAddTask" Content="Add Task ✓" Click="BtnAddTask_Click" Style="{StaticResource AccentPillButtonStyle}" HorizontalAlignment="Center" Padding="40,12" Margin="0,8"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnBack" Content="← Back" Grid.Column="0" Click="BtnBack_Click" HorizontalAlignment="Left" Background="Transparent" Foreground="#FF7F66"/>
                    <Button x:Name="BtnNext" Content="Next →" Grid.Column="1" Click="BtnNext_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="#FF7F66"/>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
