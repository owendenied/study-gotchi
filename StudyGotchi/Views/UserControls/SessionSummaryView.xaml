<UserControl x:Class="StudyGotchi.Views.UserControls.SessionSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource MainGradientBrush}">

    <Grid>
        <Border Width="620" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" Background="#FFFDFB" CornerRadius="18" Effect="{StaticResource DropShadowEffect}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="Session Summary" FontSize="28" FontWeight="Bold" Foreground="#3A1F1A"/>
                </StackPanel>

                <TextBlock Text="Great work today!" HorizontalAlignment="Center" Foreground="#8A6F6B" Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="120" Height="100" CornerRadius="12" Background="#FFF8F6" Padding="10" Margin="0,0,18,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="1" FontSize="22" FontWeight="Bold" Foreground="#FF7F66" HorizontalAlignment="Center"/>
                            <TextBlock Text="Tasks Done" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Width="120" Height="100" CornerRadius="12" Background="#FFF8F6" Padding="10" Margin="0,0,18,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="175" FontSize="22" FontWeight="Bold" Foreground="#15593F" HorizontalAlignment="Center"/>
                            <TextBlock Text="XP Earned" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Width="120" Height="100" CornerRadius="12" Background="#FFF8F6" Padding="10">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Teen" FontSize="18" FontWeight="Bold" Foreground="#7E4AB8" HorizontalAlignment="Center"/>
                            <TextBlock Text="Evolution" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Text="I'm so proud of us! ✨" HorizontalAlignment="Center" Margin="0,18"/>

                <Image Source="/Assets/Sprites/bulbasaur.png" Width="120" Height="120" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                <Button Content="Back to Dashboard" Style="{StaticResource AccentPillButtonStyle}" HorizontalAlignment="Center" Padding="60,12" Click="BtnBack_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
