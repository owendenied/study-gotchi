<UserControl x:Class="StudyGotchi.Views.UserControls.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource MainGradientBrush}">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="520" Padding="32" Background="#FFFDFB" CornerRadius="18" Effect="{StaticResource DropShadowEffect}">
            <StackPanel>
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,18">
                    <TextBlock Text="⚙️  Settings" FontSize="26" FontWeight="Bold" Foreground="#3A1F1A" HorizontalAlignment="Center"/>
                    <TextBlock Text="Make it yours before we begin" FontSize="12" Foreground="#8A6F6B" HorizontalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Pet Name" FontWeight="SemiBold" Margin="4,8"/>
                <Border Background="#FFF6F4" CornerRadius="10" Padding="8" Margin="0,4,0,12">
                    <TextBox x:Name="TxtPetName" Text="Buddy" Background="Transparent" BorderThickness="0" FontSize="14"/>
                </Border>

                <TextBlock Text="Hunger Decay Rate" FontWeight="SemiBold" Margin="4,8"/>
                <Slider Minimum="1" Maximum="3" Value="2" TickPlacement="BottomRight" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,8,0,6"/>
                <TextBlock Text="Currently: Medium" FontSize="12" Foreground="#9A8A86" Margin="0,0,0,12" HorizontalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8">
                    <TextBlock Text="Enable Reminders" VerticalAlignment="Center" Width="300"/>
                    <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="True"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,18">
                    <TextBlock Text="Focus Mode" VerticalAlignment="Center" Width="300"/>
                    <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="False"/>
                </StackPanel>

                <Button x:Name="BtnLetsGo" Content="Let's Go! →" Click="BtnLetsGo_Click" Style="{StaticResource AccentPillButtonStyle}" HorizontalAlignment="Center" Padding="40,12"/>
                <Button x:Name="BtnBack" Content="← Back" Click="BtnBack_Click" HorizontalAlignment="Left" Margin="0,12,0,0" Background="Transparent" Foreground="#FF7F66"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
