<UserControl x:Class="StudyGotchi.Views.UserControls.DashboardView"

xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

xmlns:vm="clr-namespace:StudyGotchi.ViewModels"

xmlns:local="clr-namespace:StudyGotchi"

xmlns:services="clr-namespace:StudyGotchi.Services"

xmlns:conv="clr-namespace:StudyGotchi.Converters"

Background="{StaticResource MainGradientBrush}"

FontFamily="Segoe UI" Height="521">


<UserControl.Resources>
    <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Styles/GlobalStyles.xaml" />
        </ResourceDictionary.MergedDictionaries>

        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
</UserControl.Resources>



<Grid Margin="20">

<Grid.ColumnDefinitions>

<ColumnDefinition Width="Auto" MinWidth="240"/>

<ColumnDefinition Width="1*" MinWidth="300"/>

<ColumnDefinition Width="Auto" MinWidth="280"/>

</Grid.ColumnDefinitions>



        <!-- Left side panel -->
        <Border Grid.Column="0" Style="{StaticResource SidePanelStyle}" Margin="0,0,12,0" VerticalAlignment="Stretch">
            <Border.Background>
                <ImageBrush ImageSource="/Assets/Background/pixel_bg_gray.png" 
                    Stretch="UniformToFill" 
                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                    />
               
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8" HorizontalAlignment="Center">
                    <!-- Floating Logo -->
                    <Image Source="/Assets/Background/logo.png" Width="234" Height="150" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-40,0,10" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                        </Image.Effect>
                    </Image>

                    <!-- Blue Pill Buttons -->
                    <StackPanel Orientation="Vertical" Width="200" HorizontalAlignment="Center">
                        <Button x:Name="BtnNavSelectPet" Click="BtnNavSelectPet_Click" Margin="0,0,0,12" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#1C4E96" CornerRadius="22" BorderThickness="0">
                                        <TextBlock Text="Select Pet" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="BtnNavSettings" Click="BtnNavSettings_Click" Margin="0,0,0,10" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#1C4E96" CornerRadius="22" BorderThickness="0">
                                        <TextBlock Text="Settings" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="15,10,15,0">
                    <!-- Blueish Separator -->
                    <Rectangle Height="2" Fill="#B0C4DE" Margin="0,10,0,20"/>

                    <!-- Hunger Stats -->
                    <TextBlock Text="Hunger" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,6"/>
                    <ProgressBar Value="{Binding HungerLevel, Mode=OneWay}" Maximum="100" Height="14" Foreground="#F7C844" Background="#EAEAEA" BorderThickness="0">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Border Background="{TemplateBinding Background}" CornerRadius="7">
                                    <Grid>
                                        <Border x:Name="PART_Track" />
                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="7" HorizontalAlignment="Left" />
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                    <TextBlock Text="Feeling great!" FontSize="12" Foreground="#666666" Margin="0,6,0,18"/>

                    <!-- Experience Stats -->
                    <TextBlock Text="Experience" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,6"/>
                    <ProgressBar Value="{Binding XpLevel, Mode=OneWay}" Maximum="100" Height="14" Foreground="#F97B9C" Background="#EAEAEA" BorderThickness="0">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Border Background="{TemplateBinding Background}" CornerRadius="7">
                                    <Grid>
                                        <Border x:Name="PART_Track" />
                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="7" HorizontalAlignment="Left" />
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                    <TextBlock Text="{Binding LevelText, Mode=OneWay}" FontSize="12" Foreground="#666666" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,12,0,0">
                    <!-- optional footer -->
                </StackPanel>
            </Grid>
        </Border>
        <!-- Center pet area -->

<Border Grid.Column="1" Style="{StaticResource CenterCardStyle}" Margin="0,0,12,0">

<Grid>

<!-- Session Clock -->

<Border Background="#EBD9CF" CornerRadius="12" Padding="8,6" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" RenderTransformOrigin="0.656,1.723">

<TextBlock Text="{Binding Session.ClockText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#5B3F39"/>

</Border>



<!-- Main Content Container -->



<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,20,10,20">



<!-- Pet Name -->

<TextBlock Text="{Binding PetName, Mode=OneWay}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource HeaderTextColor}" HorizontalAlignment="Center" Margin="0,0,0,10"/>



<!-- Layered Pet Area -->

<Grid Width="200" Height="200" Margin="0,0,0,12">

<!-- Background Image -->



<Image Source="/Assets/Background/pet_bg.png"

Stretch="UniformToFill"

HorizontalAlignment="Center"

VerticalAlignment="Center"/>



<!-- Pet Sprite -->

<Image Source="{Binding PetSpritePath, Mode=OneWay}"

Width="160"

Height="160"

Stretch="Uniform"

HorizontalAlignment="Center"

VerticalAlignment="Center"/>

</Grid>



<!-- Pet Stage Badge -->

<Border Background="#CFF6E0" CornerRadius="12" Padding="6,4" HorizontalAlignment="Center" Margin="0,0,0,15">

<TextBlock Text="{Binding PetStage, Mode=OneWay}" FontSize="12" Foreground="#15593F"/>

</Border>



<!-- Start Session Area -->

<StackPanel x:Name="StartSessionPlaceholder" DataContext="{Binding Session}" Visibility="{Binding IsSessionActive, Converter={StaticResource InvBoolToVis}}">

<Button Content="Start Session" Style="{StaticResource StartSessionButtonStyle}" Margin="0,0,0,12" Padding="30,10" Click="BtnStartSession_Click" HorizontalAlignment="Center"/>

</StackPanel>



<!-- Session Controls Panel -->

<!-- Wrapped in a Grid to ensure buttons have enough horizontal width -->

<Grid x:Name="SessionControlsPanel" DataContext="{Binding Session}" Visibility="{Binding IsSessionActive, Converter={StaticResource BoolToVis}}" Margin="0,5,0,0">

<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

<Button Content="Pause" Style="{StaticResource PillButtonStyle}" Click="BtnPause_Click" Margin="0,0,8,0" MinWidth="90"/>

<Button Content="End" Style="{StaticResource PillButtonStyle}" Click="BtnEndSession_Click" MinWidth="90"/>

</StackPanel>

</Grid>



</StackPanel>

</Grid>

</Border>



<!-- Right tasks panel -->

<Border Grid.Column="2" Style="{StaticResource TaskPanelStyle}" Margin="0,0,0,0" VerticalAlignment="Stretch">

<Grid>

<Grid.RowDefinitions>

<RowDefinition Height="Auto" />

<RowDefinition Height="*" />

<RowDefinition Height="Auto" />

</Grid.RowDefinitions>



<!-- Header with title and add button -->

<StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">

<TextBlock Text="Today's Tasks" FontWeight="Bold" FontSize="16" Foreground="{StaticResource HeaderTextColor}" VerticalAlignment="Center" />

<Button x:Name="BtnAddTaskTop" HorizontalAlignment="Right" Width="28" Height="28" Margin="8,0,0,0" Click="BtnAddTaskTop_Click" Background="Transparent" BorderBrush="Transparent">

<Image Source="/Assets/Background/add_button.png" RenderOptions.BitmapScalingMode="NearestNeighbor" Width="24"/>

</Button>

</StackPanel>



<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

<ItemsControl ItemsSource="{Binding Tasks.Tasks}">

<ItemsControl.ItemTemplate>

<DataTemplate>

<StackPanel Orientation="Horizontal" Margin="0,6">

<CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}" Margin="0,0,8,0" Tag="{Binding Id}" Click="TaskCheckBox_Click"/>

<StackPanel>

<TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>

<TextBlock Text="{Binding Deadline, StringFormat='{}Due {0:MMM dd}'}" FontSize="12" Background="#FFF1D8" Padding="6,3"/>

</StackPanel>

</StackPanel>

</DataTemplate>

</ItemsControl.ItemTemplate>

</ItemsControl>

</ScrollViewer>



<StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,12,0,0">

<Button Content="Open Widget →" Style="{StaticResource WidgetOpenButtonStyle}" HorizontalAlignment="Left" Click="BtnWidgetMode_Click"/>

</StackPanel>

</Grid>

</Border>



</Grid>

</UserControl>