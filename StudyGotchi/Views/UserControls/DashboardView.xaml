<UserControl x:Class="StudyGotchi.Views.UserControls.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StudyGotchi.ViewModels"
             xmlns:local="clr-namespace:StudyGotchi"
             xmlns:services="clr-namespace:StudyGotchi.Services"
             xmlns:conv="clr-namespace:StudyGotchi.Converters"
             xmlns:gif="http://wpfanimatedgif.codeplex.com"
             Background="{StaticResource MainGradientBrush}"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/GlobalStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:StringToImageSourceConverter x:Key="StringToImage" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" MinWidth="190" MaxWidth="340"/>
                <ColumnDefinition Width="2.4*" MinWidth="260"/>
                <ColumnDefinition Width="1.15*" MinWidth="220" MaxWidth="380"/>
            </Grid.ColumnDefinitions>

        <!-- Left side panel -->
        <Border Grid.Column="0" Style="{StaticResource SidePanelStyle}" Margin="0,0,12,0" VerticalAlignment="Stretch">
            <Border.Background>
                <ImageBrush ImageSource="/Assets/Background/pixel_bg_gray.png" 
                    Stretch="UniformToFill" 
                    RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Floating Logo -->
                        <Image Source="/Assets/Background/logo.png" MaxWidth="234" Height="Auto" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-10,0,10" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                            </Image.Effect>
                        </Image>

                        <!-- Blue Pill Buttons -->
                        <StackPanel Orientation="Vertical" MaxWidth="200" HorizontalAlignment="Stretch">
                            <Button x:Name="BtnNavSelectPet" Click="BtnNavSelectPet_Click" Margin="0,0,0,12" Background="Transparent" BorderThickness="0" Cursor="Hand" AutomationProperties.Name="Select pet" ToolTip="Choose a different pet">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#1C4E96" CornerRadius="22" BorderThickness="0" SnapsToDevicePixels="True" ClipToBounds="False">
                                            <TextBlock Text="Select Pet" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="BtnNavSettings" Click="BtnNavSettings_Click" Margin="0,0,0,10" Background="Transparent" BorderThickness="0" Cursor="Hand" AutomationProperties.Name="Settings" ToolTip="Open settings">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#1C4E96" CornerRadius="22" BorderThickness="0" SnapsToDevicePixels="True" ClipToBounds="False">
                                            <TextBlock Text="Settings" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="15,10,15,0">
                    <!-- Blueish Separator -->
                    <Rectangle Height="2" Fill="#B0C4DE" Margin="0,10,0,20"/>

                    <!-- Hunger Stats -->
                    <TextBlock Text="Hunger" FontSize="14" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,6"/>
                    <ProgressBar Value="{Binding HungerLevel, Mode=OneWay}" Maximum="100" Height="14" Foreground="#F7C844" Background="#EAEAEA" BorderThickness="0">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Border Background="{TemplateBinding Background}" CornerRadius="7">
                                    <Grid>
                                        <Border x:Name="PART_Track" />
                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="7" HorizontalAlignment="Left" />
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                    <TextBlock Text="{Binding PetMoodText, Mode=OneWay}" FontSize="13" Foreground="#5B514F" Margin="0,6,0,18" TextWrapping="Wrap"/>

                    <!-- Experience Stats -->
                    <TextBlock Text="Experience" FontSize="14" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,6"/>
                    <ProgressBar Value="{Binding XpLevel, Mode=OneWay}" Maximum="100" Height="14" Foreground="#F97B9C" Background="#EAEAEA" BorderThickness="0">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Border Background="{TemplateBinding Background}" CornerRadius="7">
                                    <Grid>
                                        <Border x:Name="PART_Track" />
                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="7" HorizontalAlignment="Left" />
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                    <TextBlock Text="{Binding LevelText, Mode=OneWay}" FontSize="13" Foreground="#5B514F" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,12,0,0">
                    <!-- optional footer -->
                </StackPanel>
            </Grid>
        </Border>

        <!-- Center pet area -->
        <Border Grid.Column="1" Style="{StaticResource CenterCardStyle}" Margin="0,0,12,0">
            <Grid>
                <!-- Session Clock -->
                <Border Background="#EBD9CF" CornerRadius="12" Padding="8,6" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Panel.ZIndex="2">
                    <TextBlock Text="{Binding Session.ClockText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#5B3F39"/>
                </Border>

                <!-- Main Content Container -->
                <Grid Margin="10,44,10,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="64"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding PetName, Mode=OneWay}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource HeaderTextColor}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                    <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both" MinHeight="220" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="320" Height="320">
                            <Image Source="/Assets/Background/pet_bg.png"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                            <Image gif:ImageBehavior.AnimatedSource="{Binding PetSpritePath, Mode=OneWay, Converter={StaticResource StringToImage}}"
                                   gif:ImageBehavior.RepeatBehavior="Forever"
                                   Width="250" Height="250"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Grid>
                    </Viewbox>

                    <Border Grid.Row="2" Background="#CFF6E0" CornerRadius="12" Padding="8,5" HorizontalAlignment="Center" Margin="0,10,0,10">
                        <TextBlock Text="{Binding PetStage, Mode=OneWay}" FontSize="13" Foreground="#15593F"/>
                    </Border>

                    <Grid Grid.Row="3" DataContext="{Binding Session}" VerticalAlignment="Center">
                        <Button Content="Start Session"
                                Style="{StaticResource StartSessionButtonStyle}"
                                Padding="34,10"
                                Click="BtnStartSession_Click"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsSessionActive, Converter={StaticResource InvBoolToVis}}"
                                ToolTip="Start a focus session"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsSessionActive, Converter={StaticResource BoolToVis}}">
                            <Button Content="{Binding PauseButtonText}" Style="{StaticResource PillButtonStyle}" Click="BtnPause_Click" Margin="0,0,8,0" MinWidth="90" ToolTip="Pause or resume the session"/>
                            <Button Content="End" Style="{StaticResource PillButtonStyle}" Click="BtnEndSession_Click" MinWidth="90" ToolTip="End the session and show summary"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Right tasks panel -->
        <Border Grid.Column="2" Style="{StaticResource TaskPanelStyle}" Margin="0,0,0,0" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header with title and add button -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock Text="Today's Tasks" FontWeight="Bold" FontSize="18" Foreground="{StaticResource HeaderTextColor}" VerticalAlignment="Center" />
                    <Button x:Name="BtnAddTaskTop" HorizontalAlignment="Right" Width="28" Height="28" Margin="8,0,0,0" Click="BtnAddTaskTop_Click" Background="Transparent" BorderBrush="Transparent" AutomationProperties.Name="Add task" ToolTip="Add tasks">
                        <Image Source="/Assets/Background/add_button.png" RenderOptions.BitmapScalingMode="NearestNeighbor" Width="24"/>
                    </Button>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Tasks.Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFFFC" CornerRadius="8" Padding="10,8" Margin="0,5" BorderBrush="#F3DDD8" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=OneWay}" Margin="0,4,8,0" Tag="{Binding Id}" Click="TaskCheckBox_Click" AutomationProperties.Name="{Binding Name}" ToolTip="Complete this task"/>
                                        <StackPanel Grid.Column="1">
                                            <Border Background="{Binding TypeChipColor}" CornerRadius="8" Padding="7,3" HorizontalAlignment="Left" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="11" FontWeight="Bold" Foreground="#5B3F39"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource PixelifyFont}" FontSize="15" FontWeight="SemiBold" Foreground="#3A1F1A" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontFamily" Value="{StaticResource PixelifyFont}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                <Setter Property="Foreground" Value="#8A7B78"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Background="#FFF1D8" CornerRadius="6" Padding="6,3" Margin="0,5,0,0" HorizontalAlignment="Stretch">
                                                <TextBlock Text="{Binding DisplayDeadline}" FontFamily="{StaticResource PixelifyFont}" FontSize="12" FontWeight="SemiBold" Foreground="#6E4E4A" TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,12,0,0">
                    <Button Content="Open Widget" Style="{StaticResource WidgetOpenButtonStyle}" HorizontalAlignment="Left" Click="BtnWidgetMode_Click" ToolTip="Open floating pet widget"/>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</UserControl>
