<UserControl x:Class="StudyGotchi.Views.UserControls.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StudyGotchi.ViewModels"
             xmlns:conv="clr-namespace:StudyGotchi.Converters"
             xmlns:gif="http://wpfanimatedgif.codeplex.com"
             Background="{StaticResource MainGradientBrush}"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToImageSourceConverter x:Key="StringToImage" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="240"/>
            <ColumnDefinition Width="1*" MinWidth="300"/>
            <ColumnDefinition Width="Auto" MinWidth="280"/>
        </Grid.ColumnDefinitions>

        <!-- Left side panel -->
        <Border x:Name="LeftPanel" Grid.Column="0" Style="{StaticResource CardPanelStyle}" Margin="0,0,12,0" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Study-Gotchi" FontSize="20" FontWeight="Bold" Foreground="{StaticResource HeaderTextColor}"/>
                        <Button x:Name="BtnFullScreen" Grid.Column="1" Content="⛶" Width="28" Height="28" Margin="0,0,4,0" Background="Transparent" BorderThickness="0" FontSize="16" Click="BtnFullScreen_Click" ToolTip="Toggle Full Screen (F11)"/>
                        <ToggleButton x:Name="BtnMuteToggle" Grid.Column="2" Content="🔊" Width="28" Height="28" Background="Transparent" BorderThickness="0" FontSize="16" Click="BtnMuteToggle_Click" ToolTip="Toggle Sound"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnNavSelectPet" Content="Select Pet" Background="Transparent" BorderThickness="0" Foreground="#6E4E4A" FontWeight="SemiBold" Padding="0" Margin="0,0,12,0" Click="BtnNavSelectPet_Click"/>
                        <Button x:Name="BtnNavSettings" Content="Settings" Background="Transparent" BorderThickness="0" Foreground="#6E4E4A" FontWeight="SemiBold" Padding="0" Click="BtnNavSettings_Click"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <Separator Margin="0,6"/>
                    <TextBlock Text="Hunger" FontWeight="SemiBold" Margin="0,8,0,6"/>
                    <ProgressBar Value="{Binding HungerLevel, Mode=OneWay}" Maximum="100" Height="12" Foreground="#6EE2B8" Background="#F2EFEF"/>
                    <TextBlock Text="Feeling great!" FontSize="12" Foreground="#9A8A86" Margin="0,8,0,12"/>

                    <TextBlock Text="Experience" FontWeight="SemiBold" Margin="0,8,0,6"/>
                    <ProgressBar Value="{Binding XpLevel, Mode=OneWay}" Maximum="100" Height="12" Foreground="#FF7F66" Background="#F2EFEF"/>
                    <TextBlock Text="{Binding LevelText, Mode=OneWay}" FontSize="12" Foreground="#9A8A86" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,12,0,0">
                    <!-- optional footer -->
                </StackPanel>
            </Grid>
        </Border>

        <!-- Center pet area -->
        <Border Grid.Column="1" Style="{StaticResource CardPanelStyle}" Margin="0,0,12,0">
            <Grid>
                <Border Background="#EBD9CF" CornerRadius="12" Padding="8,6" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0">
                    <TextBlock Text="{Binding Session.ClockText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#5B3F39"/>
                </Border>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
                    <Image gif:ImageBehavior.AnimatedSource="{Binding PetSpritePath, Mode=OneWay, Converter={StaticResource StringToImage}}"
                           gif:ImageBehavior.RepeatBehavior="Forever"
                           Width="200" Height="200" Stretch="Uniform"/>

                    <TextBlock Text="{Binding PetName, Mode=OneWay}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource HeaderTextColor}" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                    <Border Background="#CFF6E0" CornerRadius="12" Padding="6,4" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="{Binding PetStage, Mode=OneWay}" FontSize="12" Foreground="#15593F"/>
                    </Border>

                    <StackPanel x:Name="StartSessionPlaceholder" DataContext="{Binding Session}" Visibility="{Binding IsSessionActive, Converter={StaticResource InvBoolToVis}}">
                        <Button Content="Start Session" Style="{StaticResource StartSessionButtonStyle}" Margin="0,0,0,12" Padding="40,10" Click="BtnStartSession_Click" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Active Session Controls -->
                    <StackPanel x:Name="SessionControlsPanel" DataContext="{Binding Session}" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding IsSessionActive, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                        <Button Content="{Binding PauseButtonText}" Style="{StaticResource PillButtonStyle}" Click="BtnPause_Click" Margin="0,0,12,0"/>
                        <Button Content="End Session" Style="{StaticResource PillButtonStyle}" Click="BtnEndSession_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right tasks panel -->
        <Border x:Name="RightPanel" Grid.Column="2" Style="{StaticResource CardPanelStyle}" Margin="0,0,0,0" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <TextBlock Text="Today's Tasks" FontWeight="Bold" FontSize="16" Foreground="{StaticResource HeaderTextColor}"/>
                    <Button x:Name="BtnAddTaskTop" Content="+" HorizontalAlignment="Right" Width="28" Height="28" Margin="8,0,0,0" Click="BtnAddTaskTop_Click"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Tasks.Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,6" x:Name="TaskRow">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <!-- Immediately fade out over 0.4s -->
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="1.0" To="0.0"
                                                                                 Duration="0:0:0.4"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}" Margin="0,0,8,0" Tag="{Binding Id}" Click="TaskCheckBox_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding DisplayDeadline}" FontSize="12" Background="#FFF1D8" Padding="6,3"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,12,0,0">
                    <Button Content="Open Widget →" Style="{StaticResource WidgetOpenButtonStyle}" HorizontalAlignment="Left" Click="BtnWidgetMode_Click"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
