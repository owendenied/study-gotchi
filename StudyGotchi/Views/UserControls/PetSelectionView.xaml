<UserControl x:Class="StudyGotchi.Views.UserControls.PetSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Choose Your Pet!" FontSize="32" HorizontalAlignment="Center" Margin="20" Foreground="{StaticResource DarkText}"/>

        <UniformGrid Grid.Row="1" Columns="3" Margin="20">
            <Button x:Name="BtnSelectPetA" Margin="10" Click="BtnSelectPetA_Click">
                <Image Source="/Assets/PetA/baby.png" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Button>
            <Button x:Name="BtnSelectPetB" Margin="10" Click="BtnSelectPetB_Click">
                <Image Source="/Assets/PetB/baby.png" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Button>
            <Button x:Name="BtnSelectPetC" Margin="10" Click="BtnSelectPetC_Click">
                <Image Source="/Assets/PetC/baby.png" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Button>
        </UniformGrid>

        <Button Grid.Row="2" Content="Next" HorizontalAlignment="Right" Margin="20" Padding="20,10" Background="{StaticResource PrimaryPink}" Click="BtnNext_Click"/>
    </Grid>
</UserControl>