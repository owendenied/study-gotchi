<Window x:Class="StudyGotchi.Views.StudyWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Study-Gotchi"
        Height="450" Width="300"
        MinHeight="400" MinWidth="260"
        Topmost="True"
        WindowStyle="ToolWindow"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        Left="20" Top="20"
        Background="{StaticResource WarmCreamBrush}"
        FontFamily="Nunito, Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,8">
            <TextBlock x:Name="PetNameLabel"
                       Text="My Pet"
                       Style="{StaticResource HeadingText}"
                       FontSize="20"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="EvolutionStageLabel"
                       Text="Baby 🥚"
                       Style="{StaticResource SmallText}"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource SoftLavenderBrush}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Width="120" Height="120"
                CornerRadius="60"
                Background="White"
                HorizontalAlignment="Center"
                Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Opacity="0.4"/>
            </Border.Effect>
            <Image x:Name="PetSpriteImage"
                   Width="96" Height="96"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <Grid Margin="0,0,0,4">
                <TextBlock Text="🍖 Hunger" Style="{StaticResource SmallText}"/>
                <TextBlock x:Name="HungerValueLabel" Text="100%"
                           Style="{StaticResource SmallText}"
                           HorizontalAlignment="Right"/>
            </Grid>
            <ProgressBar x:Name="HungerBar" Style="{StaticResource HungerBar}" Minimum="0" Maximum="100" Value="100"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <Grid Margin="0,0,0,4">
                <TextBlock x:Name="LevelLabel" Text="⭐ Level 1" Style="{StaticResource SmallText}"/>
                <TextBlock x:Name="XpValueLabel" Text="0 / 100 XP"
                           Style="{StaticResource SmallText}"
                           HorizontalAlignment="Right"/>
            </Grid>
            <ProgressBar x:Name="XpBar" Style="{StaticResource XpBar}" Minimum="0" Maximum="100" Value="0"/>
        </StackPanel>

        <Border Grid.Row="4" CornerRadius="12" Background="White" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Tasks 📋" Style="{StaticResource SmallText}" FontWeight="Bold" Margin="0,0,0,8"/>

                <ListBox x:Name="TaskCheckList"
                         BorderThickness="0"
                         Background="Transparent"
                         FontFamily="Nunito, Segoe UI"
                         FontSize="12"
                         SelectionChanged="TaskCheckList_SelectionChanged"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="5"
                Content="End Session 🏁"
                Style="{StaticResource DangerButton}"
                HorizontalAlignment="Stretch"
                Click="EndSessionButton_Click"/>
    </Grid>
</Window>