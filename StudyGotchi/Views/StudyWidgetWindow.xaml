<Window x:Class="StudyGotchi.Views.StudyWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Widget" 
        Height="200" Width="200"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent" 
        Topmost="True" 
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Grid MouseLeftButtonDown="Window_MouseLeftButtonDown" Background="#01000000">
        <Image Source="/Assets/Background/tamagotchi.png" 
               Stretch="Uniform"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"/>

        <Viewbox Margin="56,68,59,49">
            <Image Source="{Binding PetSpritePath, Mode=OneWay}" 
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Viewbox>
    </Grid>
</Window>